{
  "name": "rokela-pdf-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "node tools/with-postgres.mjs vitest run",
    "test:approle": "ROKELA_TEST_APP_ROLE=1 node tools/with-postgres.mjs vitest run",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx tools/admin.ts migrate",
    "db:grants": "tsx tools/admin.ts grants",
    "bootstrap:operator": "tsx tools/admin.ts operator",
    "plan:set": "tsx tools/admin.ts plan",
    "license:grant": "tsx tools/admin.ts license",
    "license:revoke": "tsx tools/admin.ts license-revoke",
    "license:show": "tsx tools/admin.ts license-show",
    "postinstall": "node tools/copy-pdfjs.mjs",
    "predev": "node tools/copy-pdfjs.mjs",
    "prebuild": "node tools/copy-pdfjs.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "e2e": "node tools/with-postgres.mjs node tests/e2e/smoke.mjs",
    "deploy:prepare": "tsx tools/admin.ts config && tsx tools/admin.ts migrate && tsx tools/admin.ts grants",
    "screens": "node tools/with-postgres.mjs node tests/e2e/screens.mjs",
    "check:services": "tsx tools/check-services.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource-variable/inter": "5.1.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "1.0.0",
    "tesseract.js": "7.0.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
