{
  "name": "rokela-pdf-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rokela PDF for Android: scan, open, sign and convert documents. Reuses the web app's browser tools (../src/lib).",
  "scripts": {
    "dev": "npm run assets && vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run assets && npm run typecheck && vite build",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "assets": "node tools/copy-assets.mjs",
    "smoke": "node tests/smoke.mjs",
    "ads": "npm run build && node tools/ads/capture.mjs && node tools/ads/render.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@capacitor-mlkit/document-scanner": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.56.1",
    "typescript": "^5",
    "vite": "8.3.5"
  }
}
