{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../src/*"],
      "pdf-lib": ["./node_modules/pdf-lib"],
      "@pdf-lib/fontkit": ["./node_modules/@pdf-lib/fontkit"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
