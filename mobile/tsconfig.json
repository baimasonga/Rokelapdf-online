{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/components/editor/pdfjs": ["./src/pdfjs-shim.ts"],
      "@/*": ["../src/*"],
      "react": ["./node_modules/@types/react"],
      "pdf-lib": ["./node_modules/pdf-lib"],
      "@pdf-lib/fontkit": ["./node_modules/@pdf-lib/fontkit"],
      "@cantoo/pdf-lib": ["./node_modules/@cantoo/pdf-lib"],
      "fflate": ["./node_modules/fflate"],
      "tesseract.js": ["./node_modules/tesseract.js"],
      "pdfjs-dist": ["./node_modules/pdfjs-dist"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
